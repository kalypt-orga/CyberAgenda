<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique réseau de l'application (MASVS-NETWORK).
  - Aucun trafic en clair, nulle part.
  - Seules les CA système sont acceptées (pas les CA ajoutées par l'utilisateur).
  - Pinning SPKI par domaine de source. Toujours au moins deux pins (intermédiaire + racine
    de secours) et une date d'expiration, pour ne pas bloquer l'app si l'hébergeur change de CA.
  Recalculer un pin :
    openssl s_client -connect HOTE:443 -servername HOTE -showcerts </dev/null \
      | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der \
      | openssl dgst -sha256 -binary | base64
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Source OpenAgenda (Gandi, chaîne DigiCert) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.openagenda.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- GandiCert (intermédiaire actuel) -->
            <pin digest="SHA-256">0dflgFofXiuLoZvgRpP8N9xrpDTgZ7c1xbmTjIxym7o=</pin>
            <!-- DigiCert Global Root G2 (racine actuelle) -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kMPnBqrS2rdiVPl/s2uC/CY=</pin>
            <!-- Secours : DigiCert Global Root G3, USERTrust RSA (ancienne chaîne Gandi) -->
            <pin digest="SHA-256">uUwZgwDOxcBXrQcntwu+kYFpkiVkOaezL0WYEZ3anJc=</pin>
            <pin digest="SHA-256">x4QzPSC810K5/cMjb05Qm4k3Bw5zBn4lTdO/nEW/Td4=</pin>
        </pin-set>
    </domain-config>

    <!-- Source CTFtime (Google Trust Services) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">ctftime.org</domain>
        <pin-set expiration="2027-12-31">
            <!-- WE1 (intermédiaire actuel) -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <!-- GTS Root R4 -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
            <!-- GTS Root R1 (secours) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
        </pin-set>
    </domain-config>

    <!-- Sources hébergées chez Let's Encrypt : on épingle les racines ISRG uniquement,
         les intermédiaires (YR1, YR2, YE1…) tournant fréquemment. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">www.agendadulibre.org</domain>
        <domain includeSubdomains="false">alexandredubois.github.io</domain>
        <domain includeSubdomains="false">raw.githubusercontent.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- ISRG Root YR / YE (racines Let's Encrypt 2026) -->
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
            <!-- ISRG Root X1 / X2 (racines historiques, chaînes croisées) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
    </domain-config>

    <!-- Fond de carte OpenFreeMap (Google Trust Services) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openfreemap.org</domain>
        <pin-set expiration="2027-12-31">
            <!-- WE1 (intermédiaire actuel) -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <!-- GTS Root R4 -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
            <!-- GTS Root R1 (secours) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
        </pin-set>
    </domain-config>

    <!-- En debug uniquement, on peut faire confiance aux CA utilisateur pour inspecter le trafic
         (ex. proxy Burp sur l'émulateur). Ignoré dans les builds release. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
